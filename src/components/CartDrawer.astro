---
interface Props {
  phone: string;
}
const { phone } = Astro.props;
---

<div id="cart-root" data-phone={phone}>
  <button
    id="cart-fab"
    type="button"
    hidden
    aria-label="Abrir pedido"
    aria-expanded="false"
    aria-controls="cart-panel"
    class="fixed bottom-4 right-4 z-20 flex h-14 w-14 items-center justify-center rounded-full bg-brand text-white shadow-lg hover:bg-brand-dark"
  >
    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <circle cx="8" cy="21" r="1"></circle>
      <circle cx="19" cy="21" r="1"></circle>
      <path d="M2.05 2.05h2l2.66 12.42a2 2 0 0 0 2 1.58h9.78a2 2 0 0 0 1.95-1.57l1.65-7.43H5.12"></path>
    </svg>
    <span
      id="cart-badge"
      class="absolute -right-1 -top-1 flex h-6 min-w-6 items-center justify-center rounded-full bg-stone-800 px-1 text-xs font-bold"
    >0</span>
  </button>

  <div id="cart-overlay" hidden class="fixed inset-0 z-30 bg-black/40"></div>

  <aside
    id="cart-panel"
    role="dialog"
    aria-modal="true"
    aria-labelledby="cart-title"
    hidden
    class="fixed inset-x-0 bottom-0 z-40 flex max-h-[85vh] flex-col rounded-t-2xl bg-white shadow-2xl sm:inset-y-0 sm:left-auto sm:right-0 sm:max-h-none sm:w-96 sm:rounded-none"
  >
    <div class="flex items-center justify-between border-b border-stone-200 p-4">
      <h2 id="cart-title" class="text-lg font-bold">Tu pedido</h2>
      <button id="cart-close" type="button" aria-label="Cerrar" class="h-9 w-9 rounded-full text-xl hover:bg-stone-100">×</button>
    </div>

    <ul id="cart-items" class="flex-1 divide-y divide-stone-100 overflow-y-auto px-4"></ul>

    <div class="space-y-3 border-t border-stone-200 p-4">
      <div class="flex items-center justify-between text-lg font-bold">
        <span>Total estimado</span>
        <span id="cart-total">$ 0</span>
      </div>
      <div class="flex gap-2">
        <button id="cart-clear" type="button" class="rounded-full px-4 py-2 text-sm font-medium text-stone-600 ring-1 ring-stone-300 hover:bg-stone-100">
          Vaciar
        </button>
        <a id="cart-send" href="#" target="_blank" rel="noopener noreferrer" class="flex-1 rounded-full bg-brand px-5 py-2 text-center text-sm font-semibold text-white hover:bg-brand-dark">
          Enviar por WhatsApp
        </a>
      </div>
    </div>
  </aside>
</div>